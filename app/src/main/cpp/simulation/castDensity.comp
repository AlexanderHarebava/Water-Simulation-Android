// castDensity.comp — int → 2×half-float, как в Splash
#version 310 es
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer DensityGrid  { int  densityGrid[]; };
layout(std430, binding = 1) writeonly buffer CastedGrid  { uint castedGrid[]; };

uniform int   uPairCount;
uniform float uDensityMInv;
uniform float uDensityScale;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(uPairCount)) return;
    float d0 = float(densityGrid[2*id])   * uDensityMInv * uDensityScale;
    float d1 = float(densityGrid[2*id+1]) * uDensityMInv * uDensityScale;
    castedGrid[id] = pack2x16float(vec2(d0, d1));
}